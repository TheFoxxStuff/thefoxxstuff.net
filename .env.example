# Сгенерировать один раз: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=REPLACE_WITH_YOUR_SECRET_KEY

# MongoDB (не менять если используется docker-compose)
MONGODB_URL=mongodb://mongodb:27017
DATABASE_NAME=thefoxxstuff

# Redis
REDIS_URL=redis://redis:6379/0

# Frontend URL для CORS
FRONTEND_URL=https://thefoxxstuff.net

# Логирование: DEBUG / INFO / WARNING
LOG_LEVEL=INFO
